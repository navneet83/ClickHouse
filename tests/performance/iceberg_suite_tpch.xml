<!-- https://clickhouse.com/docs/getting-started/example-datasets/tpch -->
<!-- Scale factor: 10 -->
<test profile_all_queries="1">
    <settings file="../benchmarks/tpc-h/settings.json"/>
    <settings>
        <max_bytes_ratio_before_external_join>0</max_bytes_ratio_before_external_join>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
    </settings>

    <!-- TPC-H suite: the 22 queries of tpch.xml, unchanged, over the CI-attached
         Iceberg TPC-H SF10 dataset instead of the MergeTree one. The dataset is
         downloaded as a tarball and attached as the `tpch_ice10` database in
         Configure, so this suite builds nothing: it has no create_query and no
         conversion insert of its own, and the measured time is the Iceberg read
         path rather than a read plus a rebuild of the tables.

         Because the tables now ship with the dataset, they carry the types the
         TPC-H schema calls for (`tests/benchmarks/tpc-h/init.sql`): measures are
         `Decimal(12, 2)` and fixed text is `FixedString(N)`, so the results match
         `tpch.xml` instead of deviating through `Float64` money. Dates read back
         as `Date32`, because Iceberg's `date` is 32-bit.

         Nothing here drops a table, and `iceberg_delete_data_on_drop` must stay
         off: the dataset is shared by both compared servers and by every other
         test in the run, so a DROP would delete its files. -->
    <substitutions>
        <substitution>
            <name>database</name>
            <values>
                <value>tpch_ice10</value>
            </values>
        </substitution>
    </substitutions>

    <!-- The query files below use unqualified table names, as in tpch.xml, so the
         session has to point at the dataset's database. This is the only setup
         statement the suite needs. -->
    <fill_query>USE {database}</fill_query>

    <!-- Q1 -->  <query file="../benchmarks/tpc-h/queries/query_01.sql"/>
    <!-- Q2 -->  <query file="../benchmarks/tpc-h/queries/query_02.sql"/>
